# FangDash web app — local development environment.
# Copy to .env.local and adjust for your setup:
#   cp apps/web/.env.example apps/web/.env.local

# Base URL of the FangDash API (Hono on Cloudflare Workers).
NEXT_PUBLIC_API_URL=http://localhost:8787

# PartyKit host for real-time multiplayer races (partykit dev default).
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
